# Copia estos valores en Easypanel › servicio de la app › Environment
# Conexión interna (misma VPS): host = <proyecto>_<servicio> de Postgres, puerto 5432, sin SSL
DATABASE_URL=postgres://levantamientos:PASSWORD@hub_disenarte_levantamientos-db:5432/levantamientos
PGSSL=off
DB_POOL_MAX=10
SESION_DIAS=30
# PORT=3000          # puerto interno del contenedor
# ORIGEN_PERMITIDO=https://levantamientos.disenartemx.com   # CORS; por defecto *
